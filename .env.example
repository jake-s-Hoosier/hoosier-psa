# Copy to .env for local development. Never commit real values.

# Which environment this process is: development | test | uat | shadow | production.
# Must equal the marker stored in the database or the app refuses to start (docs/12).
APP_ENV=development
# read_only (default) = PostgreSQL itself rejects writes. read_write is a deliberate choice, and is
# refused for production until go-live is approved.
DB_WRITE_MODE=read_only
# QuickBooks export, payment providers and customer email. Only allowed when APP_ENV=production.
INTEGRATIONS_ENABLED=false

# Dedicated application database (NOT cw_datawarehouse; see docs/adr/0002).
DATABASE_URL=postgres://hoosier_psa:change-me@localhost:5432/hoosier_psa

# Read-only connection to the CW mirror, used only by the one-time import tooling.
CW_MIRROR_URL=postgres://cw_readonly:change-me@localhost:5432/cw_datawarehouse

API_HOST=127.0.0.1
API_PORT=4000
LOG_LEVEL=info

# Staff sign-in: 'session' (password + authenticator code) or 'dev' (header; local only, refused in production).
# See docs/08-security.md and docs/adr/0010-local-authentication.md.
AUTH_MODE=dev
# Signs session cookies and encrypts MFA secrets. At least 32 random characters, e.g. `openssl rand -base64 48`.
AUTH_SECRET=

# Inbound email to tickets through Microsoft 365 (docs/adr/0012-microsoft-365-mail.md). Off by default.
# Needs a writable database; refused in the shadow; in production also needs INTEGRATIONS_ENABLED=true.
MAIL_POLL_ENABLED=false
MAIL_POLL_INTERVAL_SECONDS=60
# Entra app registration with the Mail.Read APPLICATION permission, restricted to the support mailbox
# by an application access policy (docs/08-security.md).
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
