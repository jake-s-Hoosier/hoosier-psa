# Copy to .env for local development. Never commit real values.

# Dedicated application database (NOT cw_datawarehouse; see docs/adr/0002).
DATABASE_URL=postgres://hoosier_psa:change-me@localhost:5432/hoosier_psa

# Read-only connection to the CW mirror, used only by the one-time import tooling.
CW_MIRROR_URL=postgres://cw_readonly:change-me@localhost:5432/cw_datawarehouse

API_HOST=127.0.0.1
API_PORT=4000
LOG_LEVEL=info

# Microsoft Entra ID (OIDC) for staff sign-in. See docs/08-security.md.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
SESSION_SECRET=change-me-to-a-long-random-string
